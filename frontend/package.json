{
  "name": "pipelines-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.22.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@tanstack/react-query": "^5.107.1",
    "@xyflow/react": "^12.12.1",
    "ace-builds": "^1.45.2",
    "dagre": "^0.8.5",
    "js-yaml": "^5.5.0",
    "re-resizable": "^6.11.2",
    "react": "^19.3.1",
    "react-ace": "^15.0.0",
    "react-dom": "^19.3.1",
    "react-virtualized": "^10.0.1",
    "react-virtualized-auto-sizer": "^2.0.4",
    "typestyle": "^2.4.0"
  },
  "scripts": {
    "build:tailwind": "tailwindcss -i src/tailwind.css -o src/build/tailwind.output.css",
    "prestart": "npm run build:tailwind",
    "start": "vite --host 127.0.0.1",
    "prebuild": "npm run build:tailwind",
    "build": "npm run lint && npm run typecheck && vite build",
    "prebuild:viewer": "npm run build:tailwind",
    "build:viewer": "vite build --config vite.viewer.config.mts",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "format:check": "prettier --check 'src/**/*.{ts,tsx}'",
    "pretest": "npm run build:tailwind",
    "test": "vitest run",
    "test:ui": "vitest run",
    "test:ui:coverage": "vitest run --coverage",
    "test:viewer": "npm run build:viewer && node --test scripts/standalone-viewer.smoke.mjs",
    "test:bundle": "npm run build && node --test scripts/native-bundle.smoke.mjs",
    "test:deployment": "node --test scripts/argo-deployment.smoke.mjs",
    "test:ci": "npm run format:check && npm run build && npm test && npm run test:viewer && node --test scripts/native-bundle.smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/dagre": "^0.7.54",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "8.72.2",
    "@typescript-eslint/parser": "8.72.2",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.5",
    "@tailwindcss/cli": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
