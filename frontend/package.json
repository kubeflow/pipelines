{
  "name": "pipelines-frontend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.15.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^5.18.0",
    "@mui/material": "^5.18.0",
    "@tanstack/react-query": "^5.104.4",
    "@xyflow/react": "^12.12.0",
    "ace-builds": "^1.45.0",
    "d3-dsv": "^3.0.1",
    "dagre": "^0.8.5",
    "http-proxy-middleware": "^4.2.0",
    "immer": "^11.1.21",
    "js-yaml": "^5.5.0",
    "lodash": "^4.18.1",
    "markdown-to-jsx": "^9.10.3",
    "proto3-json-serializer": "^4.1.0",
    "protobufjs": "~8.8.1",
    "re-resizable": "^6.11.2",
    "react": "^19.3.1",
    "react-ace": "^15.0.0",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "react-router": "^8.4.0",
    "react-textarea-autosize": "^8.5.9",
    "react-virtualized": "^9.22.6",
    "recharts": "^3.10.1",
    "runtypes": "^7.0.5",
    "ts-proto": "^2.17.0",
    "typestyle": "^2.4.0",
    "url": "^0.11.4"
  },
  "scripts": {
    "analyze-bundle": "vite build --mode analyze",
    "apis:all": "node scripts/generate_openapi_typescript_fetch.js all",
    "apis": "node scripts/generate_openapi_typescript_fetch.js v2",
    "apis:v2": "node scripts/generate_openapi_typescript_fetch.js v2",
    "apis:v2:artifact": "node scripts/generate_openapi_typescript_fetch.js v2:artifact v2:artifact-server",
    "apis:v2:experiment": "node scripts/generate_openapi_typescript_fetch.js v2:experiment",
    "apis:v2:recurringrun": "node scripts/generate_openapi_typescript_fetch.js v2:recurringrun",
    "apis:v2:pipeline": "node scripts/generate_openapi_typescript_fetch.js v2:pipeline",
    "apis:v2:run": "node scripts/generate_openapi_typescript_fetch.js v2:run",
    "apis:v2:filter": "node scripts/generate_openapi_typescript_fetch.js v2:filter",
    "apis:v2:auth": "node scripts/generate_openapi_typescript_fetch.js v2:auth",
    "build:tailwind": "npx tailwindcss build -i src/tailwind.css -o src/build/tailwind.output.css",
    "prestart": "npm run build:tailwind",
    "prebuild": "npm run build:tailwind",
    "build": "npm run lint && npm run typecheck && vite build",
    "build:platform-spec:kubernetes-platform": "bash ./scripts/k8splatformspec.sh",
    "build:pipeline-spec": "bash ./scripts/pipelinespec.sh",
    "docker": "COMMIT_HASH=$(git rev-parse HEAD); NODE_VERSION=$(tr -d 'v' < .nvmrc); docker build -q -t ml-pipelines-frontend:${COMMIT_HASH} --build-arg NODE_VERSION=${NODE_VERSION} --build-arg COMMIT_HASH=${COMMIT_HASH} --build-arg DATE=\"$(date -u)\" -f Dockerfile ..",
    "format": "prettier --write './**/*.{ts,tsx}'",
    "format:check": "prettier --check './**/*.{ts,tsx}' || node ./scripts/check-format-error-info.js",
    "check:react-peers": "node scripts/check-react-peers.mjs --target 19",
    "check:react-peers:18": "node scripts/check-react-peers.mjs --target 18",
    "lint": "npm run lint:ui && npm run lint:server",
    "lint:ui": "eslint src --max-warnings=0",
    "lint:server": "eslint \"server/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "typecheck:mock-backend": "tsc --noEmit -p mock-backend/tsconfig.json",
    "mock:api": "tsx watch --tsconfig mock-backend/tsconfig.json mock-backend/mock-api-server.ts 3001",
    "mock:server": "node server/dist/server.js build",
    "mock:server:inspect": "node inspect server/dist/server.js build",
    "postinstall": "npm ci --prefix ./server && npm ci --prefix ./mock-backend",
    "start:proxy": "./scripts/start-proxy.sh",
    "start:proxy-and-server": "./scripts/start-proxy-and-server.sh",
    "start:proxy-and-server-inspect": "./scripts/start-proxy-and-server.sh --inspect",
    "start": "vite",
    "sync-backend-sample-config": "node scripts/sync-backend-sample-config.js",
    "pretest": "npm run build:tailwind",
    "pretest:ui": "npm run build:tailwind",
    "pretest:ui:coverage": "npm run build:tailwind",
    "test": "LC_ALL=\"en_US.UTF-8\" vitest run",
    "test:ui": "vitest run",
    "test:bundle": "npm run build && node --test scripts/production-bundle.smoke.mjs",
    "test:ui:watch": "vitest",
    "test:ui:coverage": "vitest run --coverage",
    "test:ui:coverage:loop": "vitest run --coverage --maxWorkers 4",
    "coverage:baseline": "node scripts/coverage-baseline.mjs capture",
    "coverage:compare": "node scripts/coverage-baseline.mjs compare",
    "visual:baseline": "node scripts/visual-compare.mjs capture --out-dir .visual/baseline",
    "visual:current": "node scripts/visual-compare.mjs capture --out-dir .visual/current",
    "visual:diff": "node scripts/visual-compare.mjs diff --baseline-dir .visual/baseline --current-dir .visual/current --diff-dir .visual/diff --report .visual/report.html",
    "test:server:coverage": "npm --prefix ./server test -- --coverage",
    "test:coverage": "npm run test:ui:coverage && npm run test:server:coverage",
    "test:ci": "export CI=true && npm run format:check && npm run lint && npm run typecheck && npm run typecheck:mock-backend && npm run check:react-peers && npm run test:coverage",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-links": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-dsv": "^3.0.7",
    "@types/dagre": "^0.7.54",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/lodash": ">=4.17.26",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/react-virtualized": "^9.22.4",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "browserslist": "4.29.3",
    "eslint": "^10.13.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fs": "0.0.1-security",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.23",
    "prettier": "^3.8.1",
    "rollup-plugin-visualizer": "^5.12.0",
    "semver": "^7.7.4",
    "storybook": "^10.2.0",
    "tailwindcss": "^3.0.11",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "yaml": "^2.8.3"
  },
  "overrides": {
    "recharts": {
      "react-redux": "9.2.0"
    },
    "express": {
      "path-to-regexp": "0.1.13"
    },
    "ejs": "3.1.7",
    "json-schema": "0.4.0",
    "ansi-html": "0.0.8",
    "body-parser": "1.20.3",
    "braces": "3.0.3",
    "tmpl": "1.0.5",
    "react-dev-utils": {
      "ansi-regex": "5.0.1"
    },
    "nth-check": "2.0.1",
    "terser": "5.14.2",
    "micromatch": ">=4.0.8"
  },
  "homepage": "./",
  "browserslist": {
    "production": [
      "supports es6-module"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
