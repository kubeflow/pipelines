# Ignore committed generator outputs. The dependabot-auto-generated attribute
# is also the source of truth for the generated-file auto-commit allowlist.
api/v2alpha1/go/** linguist-generated dependabot-auto-generated
backend/api/v1beta1/go_client/** linguist-generated dependabot-auto-generated
backend/api/v1beta1/go_http_client/** linguist-generated dependabot-auto-generated
backend/api/v1beta1/python_http_client/** linguist-generated dependabot-auto-generated
backend/api/v1beta1/swagger/** linguist-generated dependabot-auto-generated
backend/api/v2beta1/go_client/** linguist-generated dependabot-auto-generated
backend/api/v2beta1/go_http_client/** linguist-generated dependabot-auto-generated
backend/api/v2beta1/python_http_client/** linguist-generated dependabot-auto-generated
backend/api/v2beta1/swagger/** linguist-generated dependabot-auto-generated
kubernetes_platform/go/** linguist-generated dependabot-auto-generated
kubernetes_platform/python/kfp/kubernetes/** linguist-generated dependabot-auto-generated

# Ignore go.sum
go.sum linguist-generated

# Ignore npm lock
frontend/package-lock.json linguist-generated
frontend/server/package-lock.json linguist-generated
frontend/test/package-lock.json linguist-generated

# Ignore generated TS client library
frontend/src/apis/* linguist-generated

.github/workflows/*.lock.yml linguist-generated=true
