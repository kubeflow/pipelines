{
  "format_version": 1,
  "cases": {
    "metric_splits": {
      "case": "multi-value MLMD metrics artifact and primary lineage row",
      "source": {
        "run_details": [
          {
            "UUID": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "contexts": [
          {
            "id": 10,
            "type": "system.PipelineRun",
            "name": "11111111-1111-4111-8111-111111111111"
          }
        ],
        "execution": {
          "id": 100,
          "type": "system.DAGExecution",
          "parent_dag_id": null
        },
        "associations": [
          {
            "context_id": 10,
            "execution_id": 100
          }
        ],
        "artifact": {
          "id": 30,
          "type": "system.Metrics",
          "uri": "minio://mlpipeline/v2/artifacts/run/metrics"
        },
        "attributions": [
          {
            "context_id": 10,
            "artifact_id": 30
          }
        ],
        "properties": [
          {
            "name": "accuracy",
            "kind": "double",
            "value": 0.9
          },
          {
            "name": "loss",
            "kind": "double",
            "value": 0.1
          },
          {
            "name": "store_session_info",
            "kind": "string",
            "value": "historical-provider-settings"
          }
        ],
        "event": {
          "id": 40,
          "artifact_id": 30,
          "execution_id": 100,
          "type": "OUTPUT",
          "path_key": "metrics"
        }
      },
      "expected": {
        "tasks": [
          {
            "uuid": "ea90e2f5-74e2-5c64-b0a0-434a8a749741",
            "source_execution_id": 100
          }
        ],
        "artifacts": [
          {
            "uuid": "8252fe42-9cd7-570d-9be9-3cbface7753e",
            "name": "accuracy",
            "number_value": 0.9,
            "metadata": {
              "store_session_info": "historical-provider-settings"
            }
          },
          {
            "uuid": "21f50cab-5d98-54ca-83b5-4ac70f9b9183",
            "name": "loss",
            "number_value": 0.1,
            "metadata": {
              "store_session_info": "historical-provider-settings"
            }
          }
        ],
        "artifact_tasks": [
          {
            "uuid": "6d88f60e-4e30-5474-b78d-d49ad2ebf6ec",
            "artifact_id": "8252fe42-9cd7-570d-9be9-3cbface7753e",
            "task_id": "ea90e2f5-74e2-5c64-b0a0-434a8a749741",
            "type": "OUTPUT",
            "key": "metrics"
          }
        ]
      },
      "dispositions": [
        {
          "source": "artifact:30",
          "status": "split",
          "reason": "two scalar metric properties create two native rows"
        },
        {
          "source": "event:40",
          "status": "map",
          "reason": "lineage edge points to the primary artifact UUID"
        }
      ]
    },
