FROM python:3.12-slim-trixie@sha256:a0f57064cbdcd6285fa45f51237ab0b35ea8ebaed06a1f5973e89e19dfb86704

COPY backend/src/tensorboard/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && rm /tmp/requirements.txt \
    && mkdir /home/tensorboard \
    && chown 1000:1000 /home/tensorboard

ENV HOME=/home/tensorboard
USER 1000:1000
EXPOSE 6006
# The viewer controller supplies the tensorboard command and its scoped options.
CMD ["tensorboard", "--bind_all"]
