FROM python:3.15-slim-trixie@sha256:65a65fc7b30b06cb6df4930fd4650697cb23f4c2698ab81fc87e4b031bc36928

# Apply distribution security fixes and enforce the patched zlib floor.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends zlib1g \
    && dpkg --compare-versions "$(dpkg-query -W -f='${Version}' zlib1g)" ge '1:1.3.dfsg+really1.3.1-1+deb13u1' \
    && rm -rf /var/lib/apt/lists/*

COPY backend/src/tensorboard/requirements.txt /tmp/requirements.txt
RUN python -m pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt \
    && mv /usr/local/bin/tensorboard /usr/local/bin/tensorboard-cli \
    && python -m pip uninstall --yes pip \
    && rm -rf /usr/local/lib/python3.12/ensurepip \
    && rm /tmp/requirements.txt \
    && mkdir /home/tensorboard \
    && chown 1000:1000 /home/tensorboard

COPY --chmod=755 backend/src/tensorboard/tensorboard.sh /usr/local/bin/tensorboard

# Training jobs update event objects outside this process; refresh GCS listings.
# Use the established GCS reader without experimental bucket-layout probes.
ENV FSSPEC_GS='{"use_listings_cache":false}' \
    GCSFS_EXPERIMENTAL_ZB_HNS_SUPPORT=false \
    HOME=/home/tensorboard
USER 1000:1000
EXPOSE 6006
# The viewer controller supplies the tensorboard command and its scoped options.
CMD ["tensorboard", "--bind_all"]
