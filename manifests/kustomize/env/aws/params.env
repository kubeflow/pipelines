# Replace with your cluster's writer endpoint, region, and database names.
mysqlHost=CHANGE_ME.cluster-xxxxxxxx.us-east-1.rds.amazonaws.com
mysqlPort=3306

# Authenticate with short-lived IAM tokens rather than the password in
# mysql-secret. Requires dbTLSCAPath, which the overlay mounts below.
dbCredentialProviderEnabled=true
dbCredentialProvider=aws-iam
dbCredentialProviderSettings={"region":"us-east-1"}
dbTLSCAPath=/etc/db-tls/ca.pem

