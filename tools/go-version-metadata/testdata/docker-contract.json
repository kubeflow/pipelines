{
  "schemaVersion": 1,
  "schema": {
    "polarity": "detect means a source or unsupported construct must not pass; allow means the input must remain managed or irrelevant",
    "classification": "managed, unsupported, irrelevant, or invalid",
    "candidateKinds": "ordered semantic source kinds; omitted when no candidate is required",
    "oracles": "optional differential oracle names: buildkit or sh",
    "executableCrossProducts": "generated source kind x instruction field x form x deferred-context acceptance cases",
    "wordExpansionCrossProducts": "generated conditional-operator branches across variable states, source kinds, and typed fields",
    "dockerConformance": "opt-in Docker --check acceptance corpus annotated with the review finding it guards"
  },
  "buildkitWordOracles": [
    {"id": "docker-backslash-concat", "escape": "\\", "word": "g\\olang:latest", "env": {}, "want": "golang:latest"},
    {"id": "docker-double-quote-concat", "escape": "\\", "word": "go\"lang\":latest", "env": {}, "want": "golang:latest"},
    {"id": "docker-single-quote-concat", "escape": "\\", "word": "go'lang':latest", "env": {}, "want": "golang:latest"},
    {"id": "docker-unicode-parameter-default", "escape": "\\", "word": "${名-golang}:latest", "env": {}, "want": "${名-golang}:latest"},
    {"id": "docker-parameter-value", "escape": "\\", "word": "${IMAGE}:latest", "env": {"IMAGE": "golang"}, "want": "golang:latest"},
    {"id": "alternate-docker-escape-does-not-make-backslash-a-shell-escape", "escape": "`", "word": "g\\olang:latest", "env": {}, "want": "g\\olang:latest"}
  ],
  "shellOracles": [
    {"id": "sh-backslash-concat", "script": "capture g\\olang:latest", "env": {}, "wantArgv": ["golang:latest"]},
    {"id": "sh-double-quote-concat", "script": "capture go\"lang\":latest", "env": {}, "wantArgv": ["golang:latest"]},
    {"id": "sh-single-quote-concat", "script": "capture go'lang':latest", "env": {}, "wantArgv": ["golang:latest"]},
    {"id": "sh-backslash-newline", "script": "capture go\\\nlang:latest", "env": {}, "wantArgv": ["golang:latest"]},
    {"id": "sh-comment-to-newline", "script": "# golang:latest\ncapture alpine # golang:latest", "env": {}, "wantArgv": ["alpine"]},
    {"id": "sh-parameter-name", "script": "golang=alpine; capture \"${#golang}\"", "env": {}, "wantArgv": ["6"]},
    {"id": "sh-parameter-operand", "script": "capture \"${IMAGE:-golang:latest}\"", "env": {}, "wantArgv": ["golang:latest"]},
    {"id": "sh-parameter-set", "script": "capture \"${IMAGE:-golang:latest}\"", "env": {"IMAGE": "alpine"}, "wantArgv": ["alpine"]}
  ],
