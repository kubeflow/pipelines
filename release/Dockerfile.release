# Based on KFP backend api client generator dockerfile
# Keep in sync with the version used in backend/api/Makefile
# Allow overriding the base image tag at build time
ARG BASE_IMAGE=ghcr.io/kubeflow/kfp-api-generator:master
FROM ${BASE_IMAGE}
ARG TARGETARCH
RUN case "${TARGETARCH}" in \
        amd64|arm64) ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}. Use amd64 or arm64." >&2; exit 1 ;; \
    esac

# Install nvm and the Node version pinned in frontend/.nvmrc.
# Pass it in at build time with:
#   --build-arg NODE_VERSION=$(tr -d 'v' < frontend/.nvmrc)
# Reference: https://stackoverflow.com/a/28390848
ARG NODE_VERSION
ENV NODE_VERSION=${NODE_VERSION}
ENV NVM_DIR=/usr/local/nvm
RUN mkdir -p $NVM_DIR && \
    curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.8/install.sh | bash && \
    . $NVM_DIR/nvm.sh && \
    nvm install $NODE_VERSION && \
    nvm alias default $NODE_VERSION && \
    nvm use default
ENV NODE_PATH=$NVM_DIR/versions/node/v$NODE_VERSION/lib/node_modules
ENV PATH=$NVM_DIR/versions/node/v$NODE_VERSION/bin:$PATH
ENV GIT_CLIFF_VERSION=2.10.0

# Build the manifest-pinned yq with the image's patched Go compiler. Downloaded
# upstream binaries retain the compiler and dependencies used at release time.
RUN cd /tmp/api-generator-tools && \
    GOTOOLCHAIN=local go build -mod=readonly -trimpath -o /usr/local/bin/yq github.com/mikefarah/yq/v4

# Make all files accessible to non-root users.
RUN chmod -R 777 $NVM_DIR && \
    chmod -R 777 /usr/local/bin

# Update npm independently of Node's bundled copy. npm 12.2.1 still bundles
# ip-address 10.7.2; pin its compatible security update until npm includes it.
ENV NPM_VERSION=12.2.1
RUN npm install --global "npm@${NPM_VERSION}" && \
    npm install --prefix /tmp/npm-security --ignore-scripts --no-audit --no-fund --save-exact ip-address@10.7.4 && \
    npm_root="$(npm root --global)" && \
    node -e 'const p = require(process.argv[1]); if (p.version !== "10.7.2") throw new Error("Review npm ip-address patch");' "$npm_root/npm/node_modules/ip-address/package.json" && \
    rm -rf "$npm_root/npm/node_modules/ip-address" && \
    mv /tmp/npm-security/node_modules/ip-address "$npm_root/npm/node_modules/ip-address" && \
    rm -rf /tmp/npm-security && \
    npm config set cache /tmp/.npm --global && \
    npm cache clean --force

RUN set -eu; \
    case "${TARGETARCH}" in \
        amd64) git_cliff_arch=x86_64 ;; \
        arm64) git_cliff_arch=aarch64 ;; \
        *) echo "Unsupported TARGETARCH: ${TARGETARCH}. Use amd64 or arm64." >&2; exit 1 ;; \
    esac; \
    curl -fL -o /tmp/git-cliff.tar.gz -H "Accept: application/octet-stream" \
        "https://github.com/orhun/git-cliff/releases/download/v${GIT_CLIFF_VERSION}/git-cliff-${GIT_CLIFF_VERSION}-${git_cliff_arch}-unknown-linux-gnu.tar.gz"; \
    tar -xzf /tmp/git-cliff.tar.gz --strip-components=1 -C /usr/local/bin git-cliff-${GIT_CLIFF_VERSION}/git-cliff; \
    rm /tmp/git-cliff.tar.gz
